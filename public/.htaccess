<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # File e cartelle reali (inclusi /assets/*)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA: solo route dell'app
  RewriteRule ^gallery/?$ /index.html [L]
  RewriteRule ^area-riservata/?$ /index.html [L]
</IfModule>
